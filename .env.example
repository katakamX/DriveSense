# Copy to .env and adjust. Never commit .env — it is gitignored.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=drivesense
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=drivesense
POSTGRES_PORT=5432

# Consumed by the backend. Inside Docker the host is `db`; running the backend
# directly on the host, it is `localhost`.
DATABASE_URL=postgresql+psycopg://drivesense:change_me_locally@localhost:5432/drivesense

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000

# python -m app.db.seed_admin — dev-only login, see README's Configuration section.
SEED_ADMIN_EMAIL=admin@drivesense.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Frontend ---------------------------------------------------------------
VITE_PORT=5173
FRONTEND_PORT=3000
