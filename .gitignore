# Environment / secrets
.env
.env.local
.env.*.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# ML artifacts and datasets (regenerate via the pipelines; reports are committed)
data/**
!data/README.md
ml/artifacts/

# Simulator telemetry recordings — reproduce with `python -m drivesense_sim --headless`.
# Matched at any depth: the default output path is relative to the working
# directory, so recordings can land under simulator/ as well as the repo root.
**/data/recordings/

# CV model assets — fetched on first run, not committed. Two copies because
# the two paths install different dependency sets and neither imports the
# other; see app/core/monitor/__init__.py.
cv/.models/
backend/app/core/monitor/.models/

# Uploaded driver-application documents (ADR 0009). Real applicant ID scans —
# never committed; a deployment mounts this path as a volume.
storage/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
